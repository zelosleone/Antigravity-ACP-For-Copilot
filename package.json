{
  "name": "antigravity-acp-for-copilot",
  "displayName": "Antigravity: Copilot Provider",
  "description": "Use your Google Antigravity plan's Gemini models in GitHub Copilot Chat, through Google's official Antigravity ACP server on your machine.",
  "version": "0.4.2",
  "type": "module",
  "publisher": "DenizhanDaklr",
  "license": "MIT",
  "icon": "images/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/zelosleone/Antigravity-ACP-For-Copilot"
  },
  "homepage": "https://github.com/zelosleone/Antigravity-ACP-For-Copilot#readme",
  "bugs": {
    "url": "https://github.com/zelosleone/Antigravity-ACP-For-Copilot/issues"
  },
  "engines": {
    "vscode": "^1.118.0"
  },
  "categories": [
    "AI",
    "Chat"
  ],
  "keywords": [
    "antigravity",
    "gemini",
    "google",
    "acp",
    "copilot"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "extensionKind": [
    "ui",
    "workspace"
  ],
  "contributes": {
    "languageModelChatProviders": [
      {
        "vendor": "antigravity-acp",
        "displayName": "Antigravity",
        "managementCommand": "antigravityAcp.manage"
      }
    ],
    "commands": [
      {
        "command": "antigravityAcp.manage",
        "title": "Antigravity: Manage"
      },
      {
        "command": "antigravityAcp.signIn",
        "title": "Antigravity: Sign In"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./ && node build.mjs",
    "lint": "eslint src",
    "package": "vsce package",
    "upstream": "node build.mjs upstream && node out/upstream.mjs"
  },
  "devDependencies": {
    "@agentclientprotocol/sdk": "1.7.0",
    "@types/node": "20.19.30",
    "@types/vscode": "^1.118.0",
    "@typescript-eslint/eslint-plugin": "8.53.0",
    "@typescript-eslint/parser": "8.53.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "0.28.2",
    "eslint": "9.39.2",
    "typescript": "5.9.3"
  }
}
